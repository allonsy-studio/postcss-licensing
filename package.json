{
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "name": "@allons-y/postcss-licensing",
  "version": "6.0.0",
  "description": "Prepends licensing information to CSS files.",
  "license": "MPL-2.0",
  "author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
  "funding": [
    {
      "type": "github",
      "url": " https://github.com/sponsors/castastrophe"
    },
    {
      "type": "buy-me-a-coffee",
      "url": "https://www.buymeacoffee.com/castastrophe"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allonsy-studio/postcss-licensing.git"
  },
  "bugs": {
    "url": "https://github.com/allonsy-studio/postcss-licensing/issues"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "changeset": "opx release add",
    "coverage": "c8 yarn test",
    "docs:build": "eleventy --config=docs/eleventy.config.js",
    "docs:start": "eleventy --serve --config=docs/eleventy.config.js",
    "docs:test": "cypress run --project docs",
    "format": "opx lint --fix",
    "lint": "opx lint",
    "postpack": "pinst --enable",
    "prepack": "pinst --disable",
    "prepare": "husky && envoy || true",
    "prepublish": "yarn test",
    "release": "opx release publish",
    "test": "ava",
    "version": "opx release version && yarn install --mode update-lockfile"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@allons-y/dashly": "^0.1.0-beta.0",
    "@allons-y/envoy": "^1.1.0",
    "@allons-y/opx-cli": "^0.2.0",
    "@allons-y/opx-lint-js": "^1.0.0",
    "@allons-y/opx-lint-json": "^0.1.0",
    "@allons-y/opx-lint-md": "^0.1.0",
    "@allons-y/opx-release": "^0.1.1",
    "@allons-y/webc-code-sample": "^0.1.0-beta.1",
    "@allons-y/webc-oss-site": "^0.1.0-beta.1",
    "@allons-y/webc-patterns": "^0.1.0-beta.1",
    "ava": "^7.0.0",
    "axe-core": "^4.11.0",
    "c8": "^12.0.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jsonc": "^3.4.1",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pinst": "^3.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6"
  },
  "keywords": [
    "css",
    "licensing",
    "plugin",
    "postcss"
  ],
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "!(*.{js,cjs,mjs})": [
      "opx lint --fix",
      "prettier --write --ignore-unknown --no-error-on-unmatched-pattern --no-warn-ignored"
    ],
    "*.{js,cjs,mjs}": "opx lint --fix",
    ".github/renovate.json": "npx --yes --package renovate -- renovate-config-validator --strict"
  },
  "oss-docs": {
    "flavor": "landing",
    "site": "docs"
  },
  "dependenciesMeta": {
    "cypress": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.0"
}
